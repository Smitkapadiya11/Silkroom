# Full WhatsApp number, including country code, digits only (e.g. 917575807403).
NEXT_PUBLIC_WHATSAPP=917575807403

# Canonical production URL (no trailing slash). Set this to your custom domain when connected.
NEXT_PUBLIC_SITE_URL=

# Razorpay keys. The secret must never use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
